datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  KITCHEN
  CASHIER
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum PaymentMethod {
  CASH
  ZAAD
  EDAHAB
  CARD
  UNPAID
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  role         Role
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

model Restaurant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  logoUrl       String?
  description   String?
  openingHours  String?
  address       String?
  phone         String?
  zaadNumber    String?
  edahabNumber  String?
  receiptFooter String?
  taxRate       Float          @default(0.10)
  exchangeRate  Float          @default(8500.0)
  createdAt     DateTime       @default(now())
  tables        Table[]
  categories    Category[]
  menuItems     MenuItem[]
  orders        Order[]
  users         User[]
  tableSessions TableSession[]
}

model Table {
  id            String         @id @default(uuid())
  tableNumber   String
  qrCodeData    String
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]
  tableSessions TableSession[]

  @@index([restaurantId])
}

model Category {
  id           String     @id @default(uuid())
  name         String
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String      @id @default(uuid())
  name         String
  description  String
  price        Float
  imageUrl     String? // Strictly mapped for scalable CDNs (Cloudinary / AWS S3)
  isAvailable  Boolean     @default(true)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model TableSession {
  id                 String        @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId            String
  table              Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status             SessionStatus @default(ACTIVE)
  totalSessionAmount Float         @default(0.0)
  paymentMethod      PaymentMethod @default(UNPAID)
  openedAt           DateTime      @default(now())
  closedAt           DateTime?
  orders             Order[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
}

model Order {
  id                  String        @id @default(uuid())
  restaurantId        String
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId             String
  table               Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableSessionId      String?
  tableSession        TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  status              OrderStatus   @default(PENDING)
  specialInstructions String        @default("")
  totalAmount         Float
  orderItems          OrderItem[]
  createdAt           DateTime      @default(now())
  paymentStatus       PaymentStatus @default(UNPAID)
  isAddon             Boolean       @default(false)

  @@index([restaurantId])
  @@index([tableId])
  @@index([tableSessionId])
  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId       String
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity         Int
  priceAtOrderTime Float // POS Standard historical pricing integrity

  @@index([orderId])
  @@index([menuItemId])
}
